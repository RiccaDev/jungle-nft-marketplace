# "true" starts the MSW worker (mocked REST API) before the app renders.
VITE_ENABLE_MOCKS=true

# Base URL used by the Axios client and matched by the MSW handlers.
VITE_API_BASE_URL=/api

# Socket.IO server origin used by socket.io-client and matched by the MSW WebSocket link.
# Defaults to the page origin when omitted.
# VITE_SOCKET_URL=http://localhost:5173
